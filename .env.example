# Скопируй этот файл в .env и подставь свои ключи Groq:
#   cp .env.example .env

GROQ_API_KEY=gsk_your_primary_key_here
GROQ_API_KEY_2=gsk_your_fallback_key_here

# --- Google Drive sync через rclone (опционально) ---
# Парсер заливает all_pdfs/ (по типам) + harvested_meta/ + harvester/state.json
# в Google Drive — без коммитов в git, без S3.
#
# Настройка:
# 1) Установить rclone (https://rclone.org/downloads/)
# 2) `rclone config` → создать remote с именем `gdrive` (см. документация/GOOGLE_DRIVE.md)
#
# GDRIVE_REMOTE=gdrive
# GDRIVE_BASE=big-data
#
# Email для User-Agent OpenAlex / Unpaywall:
# HARVESTER_EMAIL=you@example.com
#
# Если rclone.conf лежит в нестандартном месте — указать путь:
# RCLONE_CONFIG=/path/to/rclone.conf
