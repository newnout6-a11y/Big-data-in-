# Скопируй этот файл в .env и подставь свои ключи Groq:
#   cp .env.example .env

GROQ_API_KEY=gsk_your_primary_key_here
GROQ_API_KEY_2=gsk_your_fallback_key_here

# --- Google Drive upload (опционально) ---
# Для отправки спарсенного корпуса (all_pdfs/, harvested_meta/, state.json)
# в Google Drive вместо/в дополнение к S3.
#
# 1. Создай Service Account в Google Cloud Console, скачай JSON-ключ.
# 2. Создай папку в Drive и расшарь её на email сервисного аккаунта (Editor).
# 3. Скопируй ID папки из URL:
#    https://drive.google.com/drive/folders/<этот_ID>
#
# GDRIVE_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz
# GDRIVE_CREDENTIALS_FILE=/path/to/service-account.json
# # Альтернатива — содержимое JSON одной строкой (для CI/Actions):
# # GDRIVE_CREDENTIALS_JSON={"type":"service_account",...}
#
# OAuth user-credentials (если нужно, чтобы файлы принадлежали лично тебе):
# GDRIVE_OAUTH_TOKEN_FILE=/path/to/oauth-token.json
# # GDRIVE_OAUTH_TOKEN_JSON={"refresh_token":...,"client_id":...,"client_secret":...}
