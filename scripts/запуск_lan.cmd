@echo off
chcp 65001 >nul
rem Запуск ТОЛЬКО в локальной сети — без публичного туннеля.
rem Подходит когда провайдер режет localhost.run/serveo и публичную
rem ссылку получить нельзя. С телефона/планшета в той же Wi-Fi
rem сайт открывается по LAN-IP (печатается в консоли и в qr.html).
call "%~dp0запуск.cmd" --lan %*
