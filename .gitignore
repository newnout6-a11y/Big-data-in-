# Секреты — КРИТИЧНО, никогда не пушить
.env
.env.*
!.env.example

# Векторная БД (большая, регенерируется через embed_resume.py)
qdrant_db/

# Выход из ingest.py / ingest_v2.py (40+ МБ, генерируется)
chunks.jsonl
chunks_v2.jsonl

# Сырые PDF (сотни МБ, не в репо)
all_pdfs/
rejected_pdfs/
user_documents/
extracted_images/
*.pdf

# Кэш визуальной обработки тетрадей (рендеры, OCR, captions, бюджет Groq Vision)
visual_index/

# Метаданные harvester (генерируются автосбором)
harvested_meta/

# Логи harvester (raw, могут расти)
harvester/logs/harvest.log
# Состояние и JSON-отчёты прогонов коммитим (маленькие, нужны для cron)
# harvester/state.json — отслеживается
# harvester/logs/run_*.json — отслеживается

# Кэш эмбеддингов прототипов (быстро восстанавливается)
prototype_cache.npz

# Кэш Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Временные файлы runtime
_tunnel*.log
_streamlit*.log
_codex_*.log
qr.png
exports/

# Личные файлы (скрины, эксперименты, заметки) — не часть проекта
личное/

# IDE / OS
.vscode/
.idea/
.windsurf/
*.swp
.DS_Store
Thumbs.db

# Виртуальные окружения
venv/
.venv/
env/

# Бэкапы перед ingest
*.bak

# Windows NUL artifacts
NUL

# Qdrant storage (локальная)
qdrant_storage/

# Временные выходные файлы
output.txt
knowledge_hybrid_export.jsonl

# Тестовые / отладочные файлы
kiro_tests/
test_debug.py
test_encoding.py
test_imports.py
test_partial.py
test_script.py
